; ══════════════════════════════════════════════════════════════
;  Star Game —— Godot 项目配置
;  引擎版本：Godot 4.7.2 stable（标准版，GDScript）
;  设计方案：docs/DESIGN.md
;
;  ⚠️ 本文件的渲染配置是「选错就要大面积返工」的决策，见 DESIGN.md §2.4 / §5.1
;     非必要不要改动 rendering / display 两节
; ══════════════════════════════════════════════════════════════

config_version=5

[application]

config/name="Star Game"
config/description="3D 低多边形农场生活模拟（星露谷 like）。固定斜俯视相机，桌面平台。"
config/version="0.1.0-m0"
run/main_scene="res://scenes/world/farm.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
TimeManager="*res://scripts/autoload/time_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"

[debug]

gdscript/warnings/exclude_addons=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_return=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="disabled"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87)
, Object(InputEventKey,"device":-1,"physical_keycode":4194320)
]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83)
, Object(InputEventKey,"device":-1,"physical_keycode":4194322)
]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65)
, Object(InputEventKey,"device":-1,"physical_keycode":4194319)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68)
, Object(InputEventKey,"device":-1,"physical_keycode":4194321)
]
}
run={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325)
]
}
use_tool={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1)
]
}
cancel={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305)
]
}
camera_rotate_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":81)
]
}
camera_rotate_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69)
]
}
tool_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":49)
]
}
tool_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":50)
]
}
tool_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":51)
]
}
tool_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":52)
]
}
tool_5={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":53)
]
}
open_inventory={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194306)
]
}
debug_advance_day={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194341)
]
}

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/shadow_atlas/size=2048
environment/defaults/default_clear_color=Color(0.36, 0.48, 0.62, 1)
