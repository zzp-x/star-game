# ══════════════════════════════════════════════════
#  Star Game —— Git 属性 / Git LFS 规则
#  首次克隆后请执行：git lfs install --local
# ══════════════════════════════════════════════════

# ── 默认：文本文件统一 LF 换行 ───────────────────
* text=auto eol=lf

# ── Godot 文本资源：必须按文本处理 ───────────────
# 这些文件体积小、需要 diff 与合并，绝不能进 LFS
*.gd          text
*.tscn        text
*.tres        text
*.gdshader    text
*.godot       text
*.cfg         text
*.json        text
*.md          text
*.txt         text
*.csv         text
*.po          text
*.svg         text

# ── Windows 脚本：必须 CRLF 换行 ─────────────────
# cmd.exe 对 LF 行尾的 .bat 有解析边界问题，所以这两条要覆盖
# 第 7 行的 eol=lf。（gitattributes 规则「最后匹配的生效」）
# 注意：*.ps1 可以是 LF，不受影响。
*.bat         text eol=crlf
*.cmd         text eol=crlf

# ── 图片：二进制，禁止换行转换（未达 LFS 阈值）───
*.png         binary
*.jpg         binary
*.jpeg        binary
*.webp        binary
*.ico         binary

# ── ★ Git LFS：3D 模型（体积大，无法有效 diff）───
*.glb         filter=lfs diff=lfs merge=lfs -text
*.gltf        filter=lfs diff=lfs merge=lfs -text
*.fbx         filter=lfs diff=lfs merge=lfs -text
*.obj         filter=lfs diff=lfs merge=lfs -text
*.blend       filter=lfs diff=lfs merge=lfs -text
*.dae         filter=lfs diff=lfs merge=lfs -text

# ── ★ Git LFS：HDRI 天空盒与高动态贴图 ───────────
*.hdr         filter=lfs diff=lfs merge=lfs -text
*.exr         filter=lfs diff=lfs merge=lfs -text

# ── ★ Git LFS：音频 ────────────────────────────
*.wav         filter=lfs diff=lfs merge=lfs -text
*.ogg         filter=lfs diff=lfs merge=lfs -text
*.mp3         filter=lfs diff=lfs merge=lfs -text

# ── ★ Git LFS：大字体文件 ──────────────────────
*.ttf         filter=lfs diff=lfs merge=lfs -text
*.otf         filter=lfs diff=lfs merge=lfs -text

# ── 视作二进制，避免误合并 ──────────────────────
*.tga         binary
*.bmp         binary
*.psd         binary
*.zip         binary
*.7z          binary

# ══════════════════════════════════════════════════
#  ⚠️ 本段必须放在最后
#  gitattributes 的规则是「最后匹配的生效」。
#  第三方插件（addons/）内容一律不进 LFS —— 否则没装 git-lfs 的人
#  克隆下来会拿到一堆指针文件，插件直接坏掉。
#  插件里唯一的字体/图片按普通文件处理即可。
# ══════════════════════════════════════════════════
addons/** -filter -diff -merge
